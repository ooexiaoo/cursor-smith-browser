{
  "manifest_version": 3,
  "name": "Cursor-Smith",
  "version": "1.0.0",
  "description": "Forge your cursor: smearing, torchlight, flame trails, thunderbolts, CRT and more, drawn over any text field on the web.",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Cursor-Smith",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": false
    }
  ],
  "permissions": [
    "storage"
  ],
  "commands": {
    "toggle": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Turn the custom cursor on or off"
    },
    "cycle-preset": {
      "suggested_key": {
        "default": "Alt+Shift+Period"
      },
      "description": "Cycle to the next preset"
    },
    "toggle-cua-vim-mode": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Switch between CUA and Vim cursors"
    },
    "performance-report": {
      "description": "Measure frame rate for 10 seconds and copy the report"
    },
    "disable-everywhere": {
      "suggested_key": {
        "default": "Alt+Shift+X"
      },
      "description": "Turn Cursor-Smith off on every site and every synced device"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "cursor-smith.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
